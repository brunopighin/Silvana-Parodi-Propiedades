# =============================================
# CONFIGURACIÓN DE PRODUCCIÓN - HOSTINGER
# Copiar este archivo como .env y completar
# =============================================

# Base de datos (PostgreSQL - Supabase)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-us-east-2.pooler.supabase.com:5432/postgres"

# Supabase Auth
# Obtener en: Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # Settings → API → service_role (SECRETO - nunca en frontend)
SUPABASE_ANON_KEY=eyJ...          # Settings → API → anon (pública)

# Supabase Storage
# Nombre del bucket creado en Supabase Dashboard → Storage
SUPABASE_STORAGE_BUCKET=property-images

# Servidor
PORT=3001
NODE_ENV=production

# URL del frontend (tu dominio en Hostinger)
FRONTEND_URL=https://www.silvanaparodipropiedades.com

# WhatsApp (sin el + ni espacios)
WHATSAPP_NUMBER=5492323537248

# URL del sitio (para el sitemap)
SITE_URL=https://www.silvanaparodipropiedades.com

# Cloudinary (opcional - si ya tenés imágenes en Cloudinary las seguirá usando)
# Dejar vacío para usar Supabase Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
