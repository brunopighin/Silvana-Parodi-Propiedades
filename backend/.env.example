# =============================================
# CONFIGURACIÓN DE PRODUCCIÓN - HOSTINGER
# Copiar este archivo como .env y completar
# =============================================

# Base de datos (SQLite - ruta absoluta en producción)
# Reemplazar "usuario" por el usuario de Hostinger (ver SSH)
DATABASE_URL="file:/home/usuario/inmobiliaria/backend/prisma/production.db"

# Servidor
PORT=3001
NODE_ENV=production

# URL del frontend (tu dominio en Hostinger)
FRONTEND_URL=https://www.silvanaparodi.com.ar

# JWT - IMPORTANTE: cambiar por una clave aleatoria larga y segura
# Generarla con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_CLAVE_SECRETA_LARGA_Y_ALEATORIA
JWT_EXPIRES_IN=7d

# Admin inicial (cambiar ANTES de hacer el seed en producción)
ADMIN_EMAIL=admin@silvanaparodi.com.ar
ADMIN_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO

# Cloudinary (subida de imágenes a la nube)
# Crear cuenta en cloudinary.com y obtener las claves del dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp (sin el + ni espacios)
WHATSAPP_NUMBER=5492323537248

# URL del sitio (para el sitemap)
SITE_URL=https://www.silvanaparodi.com.ar
